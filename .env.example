# SGT (Issuer switch). SGT_MODE=live (default) talks to the real SGT and
# requires the SGT_* connection variables below.
# SGT_MODE=simulated replaces the Issuer with an in-process simulator for
# commercial demos of QR and NFC payments (issue #60): Card activation always
# succeeds with a fake Card token, Settlements answer TR000 and lower an
# in-memory Balance, and any amount ending in 99 cents (e.g. 10.99) is
# rejected with TR001. The SGT_* variables are then optional. Refused with
# ENVIRONMENT=PRODUCTION.
SGT_MODE=live
# Initial Balance of every Card in simulated mode, in minor units (default 1000000 = 10,000.00)
SGT_SIMULATED_INITIAL_BALANCE_MINOR=
SGT_URL=
SGT_CLIENT_ID=
SGT_API_KEY=
SGT_HMAC_SECRET=
SGT_AES_KEY=
SGT_AES_IV=
SMS_API_URL=
SMS_TOKEN=
VAULT_ADDR=
VAULT_KV_MOUNT=
VAULT_NAMESPACE=
# Vault auth: provide EITHER the AppRole pair (recommended) OR a static
# VAULT_TOKEN (legacy). At least one mode is required.
# In production prefer AppRole-only and leave VAULT_TOKEN empty: AppRole
# credentials do not expire and the app re-authenticates automatically.
# A static VAULT_TOKEN expires; the app only recovers from that on its own
# if AppRole credentials are also present (it re-logs in on 401/403).
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_TOKEN=

